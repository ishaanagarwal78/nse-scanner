# Copy to ~/nse-scanner/.env on the Pi (chmod 600). Never commit the real file.
TELEGRAM_BOT_TOKEN=
SUBSCRIBERS_KEY=
DASHBOARD_URL=https://nse-lockin-tracker.netlify.app
OWNER_CHAT=
ALERTS_LIVE=1
PRICE_ALERTS_LIVE=0
PREVIEW_CHAT=
LIVE_PUBLISH_SECONDS=60
# public https address of the Pi's live stream (set after the Tailscale Funnel step), e.g.
# LIVE_STREAM_URL=
# fan relay on GPIO 14 (physical pin 8); "float" suits 5V active-low relay modules
FAN_WIRED=0
FAN_GPIO=14
FAN_DRIVE=floathttps://nsepi.your-tailnet.ts.net/live-events
LIVE_STREAM_URL=
